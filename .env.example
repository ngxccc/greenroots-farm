# Database (Docker Compose PostgreSQL 18)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgrespassword
DB_NAME=greenroots_farm
DB_URL=postgresql://postgres:postgrespassword@localhost:5432/greenroots_farm

# Redis (Docker Compose Redis 8 - noeviction for BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# API Server
API_PORT=3000
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars

# Third-Party Adapter Pattern Drivers ('true' = MockDriver, 'false' = RealDriver)
PAYMENT_MOCK=true
SHIPPING_MOCK=true

# PayOS Sandbox (only required when PAYMENT_MOCK=false)
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Cloudinary & Resend (optional for local mock dev)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RESEND_API_KEY=

# Frontend Public URLs
NEXT_PUBLIC_API_URL=http://localhost:3000/api
VITE_API_URL=http://localhost:3000/api
