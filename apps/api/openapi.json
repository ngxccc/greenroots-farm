{
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "AppController_health_v1",
        "parameters": [],
        "responses": {
          "200": {
            "description": "System health status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "string",
                          "example": "ok"
                        },
                        "message": {
                          "type": "string",
                          "example": "System is healthy and operational"
                        },
                        "timestamp": {
                          "type": "string",
                          "example": "2026-11-14T00:00:00.000Z"
                        }
                      },
                      "required": [
                        "status",
                        "message",
                        "timestamp"
                      ]
                    }
                  },
                  "required": [
                    "success",
                    "data"
                  ]
                }
              }
            }
          }
        },
        "summary": "System health check",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/media/upload-signature": {
      "post": {
        "description": "Generates an HMAC SHA-256 signature and upload parameters for client-side direct asset uploads to Cloudinary without streaming files through API memory.",
        "operationId": "MediaController_getUploadSignature_v1",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignedUploadDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ApiResponseDto"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/SignedUploadResponseDto"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Validation failure (Bad Request)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Rfc9457ErrorResponseDto"
                },
                "example": {
                  "type": "/errors/bad-request",
                  "title": "Bad Request",
                  "status": 400,
                  "detail": "Submitted payload failed validation",
                  "instance": "/api/v1/resource",
                  "invalidParams": [
                    {
                      "name": "field",
                      "reason": "Invalid property value"
                    }
                  ],
                  "timestamp": "2026-11-16T00:00:00.000Z"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required or invalid token (Unauthorized)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Rfc9457ErrorResponseDto"
                },
                "example": {
                  "type": "/errors/unauthorized",
                  "title": "Unauthorized",
                  "status": 401,
                  "detail": "Authentication credentials are required or have expired",
                  "instance": "/api/v1/resource",
                  "invalidParams": [],
                  "timestamp": "2026-11-16T00:00:00.000Z"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden resource access (Forbidden)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Rfc9457ErrorResponseDto"
                },
                "example": {
                  "type": "/errors/forbidden",
                  "title": "Forbidden",
                  "status": 403,
                  "detail": "You do not have permission to perform this action",
                  "instance": "/api/v1/resource",
                  "invalidParams": [],
                  "timestamp": "2026-11-16T00:00:00.000Z"
                }
              }
            }
          },
          "422": {
            "description": "Semantic validation failure (Unprocessable Entity)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Rfc9457ErrorResponseDto"
                },
                "example": {
                  "type": "/errors/unprocessable-entity",
                  "title": "Unprocessable Entity",
                  "status": 422,
                  "detail": "The request was well-formed but could not be processed due to semantic errors",
                  "instance": "/api/v1/resource",
                  "invalidParams": [],
                  "timestamp": "2026-11-16T00:00:00.000Z"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Rfc9457ErrorResponseDto"
                },
                "example": {
                  "type": "/errors/internal-server-error",
                  "title": "Internal Server Error",
                  "status": 500,
                  "detail": "An unexpected internal server error occurred",
                  "instance": "/api/v1/resource",
                  "invalidParams": [],
                  "timestamp": "2026-11-16T00:00:00.000Z"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Generate Cloudinary signed upload signature (<=5MB image, <=15MB video)",
        "tags": [
          "media"
        ]
      }
    }
  },
  "info": {
    "title": "GreenRoots Farm API",
    "description": "GreenRoots Farm - Single-farm D2C commerce and operations API: authentication, users, farm traceability, catalog and FEFO inventory.",
    "version": "0.0.1",
    "contact": {}
  },
  "tags": [
    {
      "name": "auth",
      "description": "Authentication, sessions and password recovery"
    },
    {
      "name": "users",
      "description": "Profiles, staff accounts and delivery addresses"
    },
    {
      "name": "farms",
      "description": "Farm settings, plots, seasons and traceability"
    },
    {
      "name": "catalog",
      "description": "Categories, products and subscription plans"
    },
    {
      "name": "inventory",
      "description": "Batches, FEFO allocations and waste write-offs"
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Format: Bearer <access_token>"
      }
    },
    "schemas": {
      "InvalidParamDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Invalid field name or payload property path",
            "example": "email"
          },
          "reason": {
            "type": "string",
            "description": "Detailed reason for the validation failure",
            "example": "Invalid email format"
          }
        },
        "required": [
          "name",
          "reason"
        ]
      },
      "Rfc9457ErrorResponseDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "Standard HTTP error type URI relative to error dictionary",
            "example": "/errors/bad-request"
          },
          "title": {
            "type": "string",
            "description": "Standard HTTP error title",
            "example": "Bad Request"
          },
          "status": {
            "type": "number",
            "description": "HTTP status code",
            "example": 400
          },
          "detail": {
            "type": "string",
            "description": "Human-readable explanation specific to this occurrence of the problem",
            "example": "Submitted data format is invalid"
          },
          "instance": {
            "type": "string",
            "description": "API request URI that triggered the error",
            "example": "/api/v1/auth/register"
          },
          "code": {
            "type": "string",
            "description": "Machine-readable error code",
            "example": "INVALID_INPUT"
          },
          "invalidParams": {
            "description": "List of invalid parameters that failed validation",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InvalidParamDto"
            }
          },
          "timestamp": {
            "type": "string",
            "description": "Timestamp when error occurred in ISO 8601 format",
            "example": "2026-11-16T00:00:00.000Z"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "timestamp"
        ]
      },
      "ApiResponseDto": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Operation success status flag",
            "example": true
          }
        },
        "required": [
          "success"
        ]
      },
      "SignedUploadResponseDto": {
        "type": "object",
        "properties": {
          "signature": {
            "type": "string",
            "description": "Cloudinary SHA-256 HMAC signature"
          },
          "timestamp": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "Unix timestamp in seconds used for signature computation"
          },
          "apiKey": {
            "type": "string",
            "description": "Cloudinary public API key"
          },
          "cloudName": {
            "type": "string",
            "description": "Cloudinary cloud name"
          },
          "folder": {
            "type": "string",
            "description": "Target Cloudinary folder"
          },
          "resourceType": {
            "type": "string",
            "enum": [
              "image",
              "video"
            ],
            "description": "Resource type: image or video"
          },
          "maxBytes": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "Maximum allowed file size in bytes"
          }
        },
        "required": [
          "signature",
          "timestamp",
          "apiKey",
          "cloudName",
          "folder",
          "resourceType",
          "maxBytes"
        ]
      },
      "SignedUploadDto": {
        "type": "object",
        "properties": {
          "resourceType": {
            "default": "image",
            "description": "Asset media type: image or video",
            "type": "string",
            "enum": [
              "image",
              "video"
            ]
          },
          "fileSizeBytes": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "description": "File size in bytes (image <= 5MB, video <= 15MB)"
          },
          "folder": {
            "type": "string",
            "enum": [
              "farming_logs",
              "complaints",
              "products",
              "waste_logs"
            ],
            "description": "Target asset storage folder with role authorization"
          }
        },
        "required": [
          "fileSizeBytes",
          "folder"
        ]
      }
    }
  }
}
