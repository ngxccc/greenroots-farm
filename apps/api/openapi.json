{
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "AppController_health",
        "parameters": [],
        "responses": {
          "200": {
            "description": "System health status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "string",
                          "example": "ok"
                        },
                        "message": {
                          "type": "string",
                          "example": "Hệ thống đang hoạt động bình thường"
                        },
                        "timestamp": {
                          "type": "string",
                          "example": "2026-11-14T00:00:00.000Z"
                        }
                      },
                      "required": [
                        "status",
                        "message",
                        "timestamp"
                      ]
                    }
                  },
                  "required": [
                    "success",
                    "data"
                  ]
                }
              }
            }
          }
        },
        "summary": "System health check",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/media/upload-signature": {
      "post": {
        "operationId": "MediaController_getUploadSignature",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Generate Cloudinary signed upload signature (<=5MB image, <=15MB video)",
        "tags": [
          "media"
        ]
      }
    }
  },
