# GreenRoots Farm API - local environment template
# Managed via Doppler (`greenroots-farm` project, `dev` config).
# Run local commands via Doppler: `doppler run -- bun run dev` (or `bun run doppler:dev`).
# Never commit real credentials; Doppler is the source of truth.

# --- API Runtime & Environment ---
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# --- PostgreSQL Database ---
# Runtime connection (Neon pooler or local Docker Compose); drizzle-kit migrations reuse this URL.
DB_URL=postgresql://postgres:postgrespassword@localhost:5432/greenroots_farm

# Discrete fallback used when DB_URL is absent.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgrespassword
DB_NAME=greenroots_farm
DB_LOGGING=true

# --- Redis 8 (BullMQ requires noeviction; see docker-compose.yml) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Authentication & JWT ---
# Minimum 32-character secrets for HMAC-SHA256 signing.
JWT_ACCESS_SECRET=your-jwt-access-secret-minimum-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-jwt-refresh-secret-minimum-32-chars-long
JWT_REFRESH_EXPIRES_IN=7d

# --- Mail Service (Resend or Mock) ---
MAIL_DRIVER=mock
RESEND_API_KEY=
EMAIL_FROM="GreenRoots Farm <no-reply@greenroots.farm>"

# --- Payment Gateway (PayOS or Mock) ---
PAYMENT_DRIVER=mock
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# --- Cloud Storage (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=greenroots-farm
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Scheduled Tasks & Cron ---
CRON_SECRET=local-development-secret-key

# --- BFF Trust Boundary ---
# Optional in local dev; required in split production (Vercel + Render) so API trusts X-BFF-Client-IP.
INTERNAL_PROXY_SECRET=

# --- Public Endpoints & Cross-Origin Resource Sharing (CORS) ---
# Storefront (3001) and Backoffice (3002)
CORS_ORIGINS=http://localhost:3001,http://localhost:3002
STOREFRONT_URL=http://localhost:3001
BACKOFFICE_URL=http://localhost:3002
