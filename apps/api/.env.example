# GreenRoots Farm API - local environment template
# Copy to .env for local development, or materialize values through Doppler.
# Never commit real credentials; Doppler is the source of truth.

# --- API runtime ---
PORT=3001
# Legacy alias from the former root template; ignored when PORT is set.
API_PORT=3001
NODE_ENV=development
LOG_LEVEL=debug

# --- PostgreSQL ---
# Runtime connection (Neon pooler or local Docker Compose); drizzle-kit
# migrations reuse this same URL.
DB_URL=postgresql://postgres:postgrespassword@localhost:5432/greenroots_farm

# Discrete fallback used when DB_URL is absent.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgrespassword
DB_NAME=greenroots_farm
DB_LOGGING=true

# --- Redis 8 (BullMQ requires noeviction; see docker-compose.yml) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- JWT ---
# Refresh tokens are opaque 256-bit hex strings, never JWTs.
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
# Reserved for future signing needs; opaque refresh tokens do not use it today.
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# --- Adapter mock drivers ('true' = mock, 'false' = real provider) ---
PAYMENT_MOCK=true
SHIPPING_MOCK=true

# --- PayOS sandbox (only required when PAYMENT_MOCK=false) ---
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# --- Cloudinary & Resend (optional in local mock development) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RESEND_API_KEY=
EMAIL_FROM="GreenRoots Farm <no-reply@greenroots.farm>"

# --- Public URLs and CORS ---
# Storefront (3000) and backoffice (3002) own their own public API variables;
# the API only needs their origins for CORS.
CORS_ORIGINS=http://localhost:3000,http://localhost:3002
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3002
