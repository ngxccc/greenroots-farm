{
  "name": "@greenroots/storefront",
  "version": "0.0.1",
  "description": "GreenRoots Farm Customer Storefront - Next.js 16, React 19, Tailwind CSS v4 and Base UI",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check-types": "tsc --noEmit",
