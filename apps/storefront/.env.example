# GreenRoots Farm Storefront - local environment template
# Managed via Doppler (`greenroots-farm` project, `dev` config).
# Run local commands via Doppler: `doppler run -- bun run dev` (or `bun run doppler:dev`).

# --- Runtime URLs ---
NEXT_PUBLIC_APP_URL=http://localhost:3001
API_BASE_URL=http://localhost:3000
NODE_ENV=development
MAINTENANCE_MODE=false

# --- BFF Trust Boundary ---
# Optional in local dev; required in split production (Vercel + Render) to authenticate X-BFF-Client-IP.
INTERNAL_PROXY_SECRET=
