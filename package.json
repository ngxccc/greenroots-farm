{
  "name": "greenroots-farm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4",
  "catalog": {
    "@types/bun": "^1.4.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "lucide-react": "^1.76.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5",
    "tailwindcss": "^4.3.1",
    "typescript": "^6",
    "zustand": "^5.0.15"
  },
  "scripts": {
    "actions:pin": "bun scripts/pin-actions.ts",
    "check": "bun run check-types && bun run lint && bun run check:tailwind",
    "check:tailwind": "bun scripts/check-tailwind-canonical.ts",
    "check-types": "bun run --parallel check-types:shared check-types:ui check-types:api check-types:storefront check-types:backoffice check-types:scripts",
    "check-types:api": "cd apps/api && bun run check-types",
    "check-types:backoffice": "cd apps/backoffice && bun run check-types",
    "check-types:scripts": "tsc --noEmit -p scripts/tsconfig.json",
    "check-types:shared": "cd packages/shared && bun run check-types",
    "check-types:storefront": "cd apps/storefront && bun run check-types",
    "check-types:ui": "cd packages/ui && bun run check-types",
    "clean": "rm -rf apps/api/dist apps/storefront/.next apps/backoffice/dist",
    "dev": "bun --filter '*' dev",
    "dev:api": "cd apps/api && bun run dev",
    "dev:backoffice": "cd apps/backoffice && bun run dev",
    "dev:storefront": "cd apps/storefront && bun run dev",
    "docker:down": "docker compose down",
    "docker:up": "docker compose up -d",
    "doppler:db:migrate": "cd apps/api && bun run doppler:db:migrate",
    "doppler:db:push": "cd apps/api && bun run doppler:db:push",
    "doppler:db:seed": "cd apps/api && bun run doppler:db:seed",
    "doppler:dev": "doppler run -- bun run dev",
    "doppler:dev:api": "cd apps/api && bun run doppler:dev",
    "doppler:dev:backoffice": "cd apps/backoffice && bun run doppler:dev",
    "doppler:dev:storefront": "cd apps/storefront && bun run doppler:dev",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "format:pkg": "syncpack format",
    "format:pkg:check": "syncpack format --check",
    "install:all": "bun install",
    "lint": "bun run lint:api && bun run lint:ui && bun run lint:storefront && bun run lint:backoffice",
    "lint:api": "cd apps/api && bun run lint",
    "lint:backoffice": "cd apps/backoffice && bun run lint",
    "lint:fast": "oxlint --type-aware --fix",
    "lint:storefront": "cd apps/storefront && bun run lint",
    "lint:ui": "cd packages/ui && bun run lint",
    "prepare": "husky",
    "release": "bun scripts/release.ts",
    "test": "bun run --parallel test:shared test:api test:storefront test:backoffice test:scripts",
    "test:all": "bun run test && bun run test:e2e",
    "test:api": "cd apps/api && bun run test",
    "test:backoffice": "cd apps/backoffice && bun run test",
    "test:e2e": "cd apps/api && bun run test:e2e",
    "test:scripts": "bun test scripts/",
    "test:shared": "cd packages/shared && bun run test",
    "test:storefront": "cd apps/storefront && bun run test",
    "types:sync": "cd apps/api && bun run openapi:generate",
    "version:bump": "bun scripts/version.ts bump",
    "version:check": "bun scripts/version.ts check"
  },
  "devDependencies": {
    "@tailwindcss/node": "^4.3.5",
    "@tailwindcss/oxide": "^4.3.5",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "eslint-plugin-oxlint": "1.94.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-config-presets": "0.1.25",
    "oxlint-tsgolint": "7.0.2007",
    "syncpack": "^15.3.3",
    "typescript": "catalog:"
  },
  "license": "SEE LICENSE IN LICENSE",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
