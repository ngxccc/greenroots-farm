{
  "name": "greenroots-farm",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4",
  "catalog": {
    "@types/bun": "^1.4.4",
    "typescript": "^6"
  },
  "scripts": {
    "check": "bun run check-types && bun run lint",
    "check-types": "bun run check-types:shared && bun run check-types:api",
    "check-types:api": "cd apps/api && bun run check-types",
    "check-types:backoffice": "cd apps/backoffice && bun run check-types",
    "check-types:shared": "cd packages/shared && bun run check-types",
    "check-types:storefront": "cd apps/storefront && bun run check-types",
    "clean": "rm -rf apps/api/dist apps/storefront/.next apps/backoffice/dist",
    "dev:api": "cd apps/api && bun run dev",
    "dev:backoffice": "cd apps/backoffice && bun run dev",
    "dev:storefront": "cd apps/storefront && bun run dev",
    "docker:down": "docker compose down",
    "docker:up": "docker compose up -d",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "format:pkg": "syncpack format",
    "format:pkg:check": "syncpack format --check",
    "install:all": "bun install",
    "lint": "bun run lint:api && bun run lint:storefront && bun run lint:backoffice",
    "lint:api": "cd apps/api && bun run lint",
    "lint:backoffice": "cd apps/backoffice && bun run lint",
    "lint:fast": "oxlint --type-aware --fix",
    "lint:storefront": "cd apps/storefront && bun run lint",
    "prepare": "husky",
    "test": "bun run test:shared && bun run test:api",
    "test:api": "cd apps/api && bun run test",
    "test:backoffice": "cd apps/backoffice && bun run test",
    "test:shared": "cd packages/shared && bun run test",
    "test:storefront": "cd apps/storefront && bun run test",
    "types:sync": "cd apps/api && bun run openapi:generate"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "eslint-plugin-oxlint": "1.93.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-config-presets": "0.1.21",
    "oxlint-tsgolint": "7.0.2006",
    "syncpack": "^15.3.3",
    "typescript": "catalog:"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
